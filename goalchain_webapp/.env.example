# Solana RPC for wallet + on-chain reads
VITE_RPC_URL=https://api.devnet.solana.com

# GoalChain API (ops status, economy config/metrics). No trailing slash.
# Dev: local API. Prod: omit or use CRM path (Vercel must NOT use api.goalchain.io until DNS exists).
VITE_API_BASE_URL=http://localhost:3001
# Vercel Production (recommended): leave unset, or:
# VITE_API_BASE_URL=https://crm.goalchain.fun/goalchain-api

# Optional override (defaults to devnet program id in SDK)
# VITE_PROGRAM_ID=FbDhM4itBS2Cco7c7PbNvC98Fx7Y5HxqXS1JuXdNcBwg

# Zealy API (for real XP/leaderboard sync)
VITE_ZEALY_API_BASE=https://api.zealy.io/v1
VITE_ZEALY_API_KEY=
VITE_ZEALY_COMMUNITY_ID=
VITE_ZEALY_REFERRAL_BASE=https://zealy.io/cw/goalchain
