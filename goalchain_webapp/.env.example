# Solana RPC for wallet + on-chain reads
VITE_RPC_URL=https://api.devnet.solana.com

# GoalChain API (ops status, economy config/metrics)
# Production: https://your-api-host (no trailing slash)
# Omit for dev — Ops panel shows offline; wallet flows still work via RPC
VITE_API_BASE_URL=http://localhost:3001

# Optional override (defaults to devnet program id in SDK)
# VITE_PROGRAM_ID=FbDhM4itBS2Cco7c7PbNvC98Fx7Y5HxqXS1JuXdNcBwg
