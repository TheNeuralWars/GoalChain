    "ink": "#f4f4f6",
    "muted": "#b4b9c7",
    "faint": "#8e95a8",
    "inkInverse": "#0a0b0e",
    "amberPrimary": "#e5a93c",
    "amberLight": "#f1c26b",
    "amberDeep": "#d98a3a",
    "amberGrad": "linear-gradient(120deg, #f1c26b, #e5a93c 55%, #d98a3a)",
    "cobaltCode": "#3b82f6",
    "cobaltText": "#93b8ff",
    "crimsonCinema": "#e11d48",
    "crimsonText": "#fda4af",
    "violetStudio": "#8b7cf6",
    "violetText": "#b8acff",
    "success": "#22c55e",
    "successText": "#4ade80",
    "warning": "#fbbf24",
    "warningText": "#fcd34d",
    "danger": "#ef4444",
    "dangerText": "#f87171",
    "info": "#7fb2ff",
    "line": "rgba(255, 255, 255, 0.08)",
    "lineStrong": "rgba(255, 255, 255, 0.15)",
    "lineAmber": "rgba(229, 169, 60, 0.42)",
    "lineCobalt": "rgba(59, 130, 246, 0.42)"
