  "wcagPairs": [
    { "label": "Primary ink on obsidian canvas", "fg": "#f4f4f6", "bg": "#0a0b0e", "minRatio": 15.0 },
    { "label": "Primary ink on elevated card", "fg": "#f4f4f6", "bg": "#12141c", "minRatio": 14.0 },
    { "label": "Muted text on obsidian canvas", "fg": "#b4b9c7", "bg": "#0a0b0e", "minRatio": 8.5 },
    { "label": "Faint metadata text on obsidian canvas", "fg": "#8e95a8", "bg": "#0a0b0e", "minRatio": 5.5 },
    { "label": "Faint metadata text on elevated card", "fg": "#8e95a8", "bg": "#12141c", "minRatio": 5.0 },
    { "label": "Warm amber accent on obsidian canvas", "fg": "#e5a93c", "bg": "#0a0b0e", "minRatio": 8.5 },
    { "label": "Inverse ink on warm amber CTA button", "fg": "#0a0b0e", "bg": "#e5a93c", "minRatio": 8.5 },
    { "label": "Cobalt text on obsidian canvas", "fg": "#93b8ff", "bg": "#0a0b0e", "minRatio": 7.5 },
    { "label": "Violet text on obsidian canvas", "fg": "#b8acff", "bg": "#0a0b0e", "minRatio": 7.5 },
    { "label": "Success text on obsidian canvas", "fg": "#4ade80", "bg": "#0a0b0e", "minRatio": 9.0 },
    { "label": "Danger text on obsidian canvas", "fg": "#f87171", "bg": "#0a0b0e", "minRatio": 6.0 }
  ],
  "typography": {
    "fontSans": "\"Outfit\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "fontSerif": "\"Newsreader\", \"Instrument Serif\", \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif",
    "fontMono": "\"JetBrains Mono\", ui-monospace, \"SF Mono\", Menlo, Consolas, monospace",
    "scale": {
      "xs": "0.78rem",
      "sm": "0.9rem",
      "base": "1.0625rem",
      "lead": "clamp(1.1rem, 2.2vw, 1.32rem)",
      "h3": "clamp(1.15rem, 2.4vw, 1.45rem)",
      "h2": "clamp(1.85rem, 4.4vw, 2.85rem)",
      "h1": "clamp(2.45rem, 6.6vw, 4.3rem)",
      "display": "clamp(3rem, 8vw, 5.2rem)"
    },
    "weights": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700",
      "black": "800"
    },
    "tracking": {
      "tight": "-0.03em",
      "heading": "-0.02em",
      "subhead": "-0.015em",
      "mono": "0.12em",
      "kicker": "0.14em"
    }
  },
  "spacing": {
    "space1": "0.25rem",
    "space2": "0.5rem",
    "space3": "0.75rem",
    "space4": "1rem",
    "space5": "1.5rem",
    "space6": "2rem",
    "space7": "3rem",
    "space8": "4.5rem"
  },
  "radii": {
    "xs": "6px",
    "sm": "12px",
    "md": "16px",
    "lg": "18px",
    "xl": "24px",
    "pill": "999px"
  },
  "elevation": {
    "card": "0 10px 32px rgba(0, 0, 0, 0.42)",
    "elevated": "0 18px 46px rgba(0, 0, 0, 0.54)",
    "amberGlow": "0 12px 34px rgba(229, 169, 60, 0.22)",
    "amberGlowHover": "0 16px 44px rgba(229, 169, 60, 0.28)",
    "cobaltGlow": "0 12px 32px rgba(59, 130, 246, 0.20)",
    "focusRing": "0 0 0 3px rgba(229, 169, 60, 0.45)",
    "insetHighlight": "inset 0 1px 0 rgba(255, 255, 255, 0.06)"
  },
  "motion": {
    "ease": "cubic-bezier(0.16, 1, 0.3, 1)",
    "easeOut": "cubic-bezier(0, 0, 0.2, 1)",
    "durFast": "150ms",
    "durBase": "220ms",
    "durSlow": "450ms",
    "durReveal": "650ms"
  },
  "breakpoints": {
    "xs": "480px",
    "sm": "620px",
    "md": "768px",
    "lg": "860px",
    "xl": "980px",
    "xxl": "1280px",
    "maxw": "1160px"
  }
}
