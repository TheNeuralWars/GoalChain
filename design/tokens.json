{
  "$schema": "https://goalworld.fun/schemas/design-tokens-v1.json",
  "meta": {
    "name": "GoalWorld Unified Studio Design System",
    "version": "2.0.0",
    "updated": "2026-11-09",
    "surfaces": ["goalworld_site", "goalchain_webapp"]
  },
  "color": {
    "bg": "#0a0b0e",
