# Copy to ~/.config/goalchain-multiagent.env on VPS (never commit secrets).

GOALCHAIN_MULTIAGENT_ENABLED=0
GOALCHAIN_MA_HOST=127.0.0.1
GOALCHAIN_MA_PORT=8790
GOALCHAIN_MA_TOKEN=change-me-long-random

# mock_llm=1: rule-based routing (no API spend). Set 0 when keys are set.
GOALCHAIN_MA_MOCK_LLM=1

# One of these when MOCK_LLM=0 (Anthropic preferred if both set)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOALCHAIN_MA_MODEL=claude-sonnet-4-20250514
GOALCHAIN_MA_OPENAI_MODEL=gpt-4o-mini

GOALCHAIN_MA_MAX_HOPS=6
GITHUB_REPO=TheNeuralWars/GoalChain
HERMES_HOME=/home/goalchain/hermes
