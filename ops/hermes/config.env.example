# Hermes 24/7 — GoalChain (copy to ~/hermes/config.env)
# Never commit config.env (secrets).

# --- Repo ---
GOALCHAIN_REPO_PATH="${HOME}/hermes/workspace/GoalChain"
GITHUB_REPO="TheNeuralWars/GoalChain"
GITHUB_DEFAULT_BRANCH="main"

# GitHub PAT for Hermes scripts (create-task, dispatch, worker).
# Option A (recommended on server): bash ops/hermes/sync-github-token-to-config.sh
# Option B: fine-grained PAT → https://github.com/settings/tokens?type=beta
#   Repo TheNeuralWars/GoalChain — Issues R/W, Contents R/W, Pull requests R/W
# Option C: rely on `gh auth login` only (leave empty if gh works in cron)
GITHUB_TOKEN=""

GIT_AUTHOR_NAME="Hermes"
GIT_AUTHOR_EMAIL="hermes@goalchain.local"

# --- Pull / sync ---
SYNC_INTERVAL_MINUTES=30

# --- Read-only checks (devnet) ---
RPC_URL="https://api.devnet.solana.com"
PROGRAM_ID="FbDhM4itBS2Cco7c7PbNvC98Fx7Y5HxqXS1JuXdNcBwg"
API_BASE_URL=""
# HEALTH_URL is derived if empty: ${API_BASE_URL}/api/economy/health
HEALTH_URL=""

# --- Intake policy ---
INTAKE_PATH="docs/intake"
REQUIRE_NICO_OK_FOR_P0=true
BLOCKED_BRIEFS="2026-05-22-webapp-devnet-transactions.md"
BLOCKED_BRIEFS_REASON="Wait until PRs #32, #33, #34 are merged."

# --- Slack (Fase 2 — leave empty until ready) ---
SLACK_BOT_TOKEN=""
SLACK_CHANNEL_INTAKE=""
SLACK_CHANNEL_DEV=""
SLACK_CHANNEL_RELEASES=""

# --- Notion (optional) ---
NOTION_TOKEN=""
NOTION_DATABASE_ID=""

# --- Notifications to you (optional: Telegram, email, etc.) ---
HERMES_NOTIFY_WEBHOOK=""

# --- Webhook intake security ---
# Optional token to protect POST /webhook (header Authorization: Bearer <token> or X-OA-Token)
OA_WEBHOOK_TOKEN=""
# Optional source allow-list (comma-separated), e.g. "discord,whatsapp"
OA_WEBHOOK_ALLOWED_SOURCES=""

# --- OA research -> Discord ---
# Preferred: create a Discord incoming webhook in your dedicated research channel.
# DISCORD_RESEARCH_WEBHOOK_URL="https://discord.com/api/webhooks/..."
# Alternative: bot token + channel id.
DISCORD_TOKEN=""
DISCORD_RESEARCH_CHANNEL_ID=""
DISCORD_RESEARCH_WEBHOOK_URL=""

# X/Twitter autopost for each published research report
X_API_KEY=""
X_API_SECRET=""
X_ACCESS_TOKEN=""
X_ACCESS_SECRET=""

# Health watchdog (alerts when new reports stop reaching Discord)
OA_HEALTH_STALE_SECONDS=5400

# OA scout throughput tuning
OA_SCOUT_SCORE_MIN=28
OA_SCOUT_SCORE_MIN_FLOOR=24
OA_SCOUT_SCORE_MIN_CEIL=34
OA_SCOUT_MAX_CANDIDATES=5
OA_SCOUT_NEAR_MISS_MAX=2
OA_SCOUT_TONE=balanced
OA_SCOUT_RADAR_CRON="15 */2 * * *"
OA_SCOUT_SYNTH_CRON="30 9 * * *"
OA_SCOUT_WEEKLY_CRON="0 12 * * 1"
OA_SCOUT_AUTOTUNE_CRON="10 11 * * *"
OA_SCOUT_METRICS_WINDOW_HOURS=48

# --- Wait-mode auto dispatch commands (optional) ---
# When set, OA will auto-launch these commands after creating issues from chat/webhook.
# Each command receives:
# OA_TASK_OWNER, OA_TASK_PRIORITY, OA_TASK_TITLE, OA_TASK_OBJECTIVE,
# OA_TASK_ISSUE_URL, OA_TASK_ISSUE_NUMBER, OA_TASK_REPO
OA_AGENT_CURSOR_CMD=""
OA_AGENT_ANTIGRAVITY_CMD=""
OA_AGENT_GROK_CMD=""
OA_AGENT_OPENCODE_CMD=""
# Suggested dispatch model:
# - cursor / antigravity / opencode => local bridge queue script
# - grok => server runner (or local if desired)

# --- Cloudflare Tunnel (for OAuth callbacks / remote access) ---
# Create tunnel in Cloudflare Zero Trust, then set:
# TUNNEL_HOSTNAME=oa.tudominio.com
# TUNNEL_ID=<uuid>
# TUNNEL_CREDENTIALS_FILE=/home/goalchain/.cloudflared/<uuid>.json
# Run: bash ~/hermes/scripts/setup-tunnel-xai.sh start

# --- GBrain (memory layer on Hermes VPS) ---
# Key from https://zeroentropy.dev — not included in Copilot/Cursor/Grok subscriptions
ZEROENTROPY_API_KEY=""

# --- xAI for OpenCode/OA ---
# SuperGrok subscription (recommended): run oa-xai-connect.sh headless — no API key needed.
# Pay-as-you-go only: XAI_API_KEY from https://console.x.ai
XAI_API_KEY=
XAI_OAUTH_PORT=56121
OA_MODEL=xai/grok-4.3
