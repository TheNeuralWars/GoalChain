# Copy to ~/hermes/fcc.secrets.env on the Hermes VPS (chmod 600). Never commit fcc.secrets.env.
#
# The sk- key is your OpenRouter (or LM Studio server token if you run lms locally with auth).
# LM Studio catalog URLs are MODEL IDs, not keys — see configure-fcc-env.sh.

OPENROUTER_API_KEY="sk-your-key-here"

# Optional: comma-separated OpenRouter slugs (FCC adds open_router/ prefix if missing)
FCC_OPENROUTER_EXTRA_MODELS="qwen/qwen3-coder-next,qwen/qwen3.6-35b-a3b,google/gemma-4-31b,nvidia/nemotron-3-super,nvidia/nemotron-3-nano-omni,ibm/granite-4.1-30b,z-ai/glm-4.7-flash"

# Code agent defaults (oa-worker / fcc-claude)
FCC_MODEL="open_router/qwen/qwen3-coder-next"
FCC_MODEL_OPUS="open_router/qwen/qwen3.6-35b-a3b"
FCC_MODEL_SONNET="open_router/qwen/qwen3-coder-next"
FCC_MODEL_HAIKU="open_router/z-ai/glm-4.7-flash"

# Local LM Studio on the VPS (only if you run: lms server start --port 1234)
# LM_STUDIO_BASE_URL="http://127.0.0.1:1234/v1"
# FCC_MODEL_LMSTUDIO="lmstudio/qwen/qwen3-coder-next"
