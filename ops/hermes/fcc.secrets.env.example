# Copy to ~/hermes/fcc.secrets.env on the Hermes VPS (chmod 600). Never commit fcc.secrets.env.
#
# Guía completa: ops/hermes/FCC_PROVIDERS.md
# Upstream: https://github.com/Alishahryar1/free-claude-code

# --- Proveedores 1–14 (cloud): cada uno = *_API_KEY + slug con prefijo ---
#  1  NVIDIA_NIM_API_KEY     → nvidia_nim/...
#  2  OPENROUTER_API_KEY      → open_router/...
#  3  GEMINI_API_KEY          → gemini/...
#  4  DEEPSEEK_API_KEY        → deepseek/...
#  5  MISTRAL_API_KEY         → mistral/...
#  6  CODESTRAL_API_KEY       → mistral_codestral/...
#  7–8 OPENCODE_API_KEY        → opencode/... o opencode_go/...
#  9  WAFER_API_KEY           → wafer/...
# 10  KIMI_API_KEY            → kimi/...
# 11  CEREBRAS_API_KEY        → cerebras/...
# 12  GROQ_API_KEY            → groq/...
# 13  FIREWORKS_API_KEY       → fireworks/...
# 14  ZAI_API_KEY             → zai/...

OPENROUTER_API_KEY="sk-your-openrouter-key"
# NVIDIA_NIM_API_KEY="nvapi-..."
# OPENCODE_API_KEY="..."          # opencode.ai/auth → opencode/... slugs
# Keys added via FCC Admin UI custom providers (64-char hex, etc.):
# API_KEY_EXTRA_4="your-key-here"
# GROQ_API_KEY="gsk_..."
# GEMINI_API_KEY="..."
# (rellená solo los que uses; vacío = ignorado)

# --- Proveedores 15–17 (LOCAL): NO son API keys, solo URL del servidor ---
# NO uses esto en el VPS si cada modelo pesa 50GB+. Usá equivalentes open_router/ arriba.
# LM_STUDIO_BASE_URL="http://127.0.0.1:1234/v1"
# LLAMACPP_BASE_URL="http://127.0.0.1:8080/v1"
# OLLAMA_BASE_URL="http://127.0.0.1:11434"

# Modelos del catálogo LM Studio → slugs OpenRouter (sin instalar LM Studio)
FCC_OPENROUTER_EXTRA_MODELS="qwen/qwen3-coder-next,qwen/qwen3.6-35b-a3b,google/gemma-4-31b,nvidia/nemotron-3-super,nvidia/nemotron-3-nano-omni,ibm/granite-4.1-30b,z-ai/glm-4.7-flash"

# Recomendado en VPS: no instalar LM Studio (modelos 50GB+). Equivalentes vía OpenRouter/NIM.
FCC_CLOUD_ONLY=1

# --- Preset recomendado Hermes (solo nube, sin LM Studio en VPS) ---
FCC_MODEL="open_router/qwen/qwen3-coder-next"
FCC_MODEL_OPUS="nvidia_nim/nvidia/nemotron-3-super-120b-a12b"
FCC_MODEL_SONNET="open_router/qwen/qwen3-coder-next"
FCC_MODEL_HAIKU="groq/llama-3.3-70b-versatile"

# Si tenés NIM key, descomentá MODEL_OPUS con nemotron arriba.
# Si no, usá todo OpenRouter:
# FCC_MODEL_OPUS="open_router/qwen/qwen3.6-35b-a3b"
# FCC_MODEL_HAIKU="open_router/z-ai/glm-4.7-flash"
