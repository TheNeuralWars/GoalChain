{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "antigravity",
  "model": "github-copilot/claude-sonnet-4.5",
  "small_model": "github-copilot/claude-haiku-4.5",
  "instructions": [
    "AGENTS.md",
    "CLAUDE.md",
    ".opencode/SOUL.md",
    "ai_context/CURSOR_SESSION_CONTEXT.md",
    "ai_context/AGENT_ORCHESTRATION.md",
    "ai_context/AGENT_TOOLS_GUIDE.md",
    "ai_context/META_CHARTER.md",
    ".cursor/rules/meta-principal.mdc",
    ".cursor/rules/collab-multi-agent.mdc"
  ],
  "watcher": {
    "ignore": [
      "node_modules/**",
      "**/dist/**",
      "**/target/**",
      ".git/**",
      "_archive/**",
      "antigravity_export/**",
      "**/*.lock"
    ]
  },
  "permission": {
    "bash": {
      "*": "ask",
      "git *": "allow",
      "gh *": "allow",
      "npm *": "allow",
      "gbrain *": "allow",
      "./scripts/*": "allow"
    }
  },
  "mcp": {
    "gbrain": {
      "type": "stdio",
      "command": "{env:GBRAIN_BUN}",
      "args": ["{env:GBRAIN_CMD}", "serve"],
      "enabled": true
    }
  },
  "plugin": ["xai"],
  "agent": {
    "build": {
      "disable": false,
      "model": "github-copilot/claude-sonnet-4.5"
    },
    "plan": {
      "disable": false,
      "model": "github-copilot/claude-haiku-4.5"
    }
  },
  "command": {
    "tasks": {
      "description": "Sync repo and list Manager-assigned tasks",
      "template": "Run ./scripts/check-tasks.sh and summarize open assignments for Antigravity. Offer to start the highest-priority ready task.",
      "agent": "antigravity"
    },
    "gbrain-sync": {
      "description": "Refresh GBrain with latest intake and ai_context",
      "template": "Run: gbrain import ai_context docs/intake && gbrain embed --stale. Report chunk counts or errors.",
      "agent": "antigravity"
    },
    "review-pr": {
      "description": "Review current branch or PR like gstack /review",
      "template": "Review the git diff against main (or the open PR for this branch). Use @review subagent mindset. Output PASS/BLOCK with findings.",
      "agent": "review"
    }
  }
}
